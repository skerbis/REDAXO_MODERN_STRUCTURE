mediaplace_cronjob_thumb_warmup_result = {0} neue Bild-Vorschaubilder erzeugt ({1} geprüft), {2} neue Video-Vorschaubilder erzeugt ({3} geprüft), {4} neue PDF-Vorschaubilder erzeugt ({5} geprüft).
mediaplace_thumb_warmup_legend = Vorschaubilder vorwärmen
mediaplace_thumb_warmup_intro = Erzeugt alle Grid-Vorschaubilder einmal komplett vorab, statt sie erst beim ersten Betrachten "on demand" zu generieren – hilfreich nach einer Migration oder Erstinstallation mit vielen bereits vorhandenen Dateien, wenn auf einem langsamen Server viele gleichzeitige Vorschau-Anfragen beim Scrollen spürbar bremsen. Läuft nacheinander in kleinen Häppchen (kein paralleler Ansturm auf den Server), bereits gecachte Dateien werden dabei übersprungen. Ergänzend gibt es auch einen Cronjob, der neue Dateien laufend automatisch nachzieht.
mediaplace_thumb_warmup_start_background = Im Hintergrund starten
mediaplace_thumb_warmup_start_browser = Im Browser starten
mediaplace_thumb_warmup_background_hint = "Im Hintergrund" läuft auf dem Server weiter, auch wenn du den Tab schließt – lade die Seite später einfach neu, um den Fortschritt zu sehen. "Im Browser" treibt den Vorgang direkt hier an, der Tab muss dafür geöffnet bleiben; automatischer Rückfall, falls der Server keine Hintergrundprozesse erlaubt.
mediaplace_thumb_warmup_cancel = Abbrechen
mediaplace_thumb_warmup_progress = Fortschritt
mediaplace_thumb_warmup_images = Bilder
mediaplace_thumb_warmup_videos = Videos
mediaplace_thumb_warmup_pdfs = PDFs
mediaplace_thumb_warmup_of = von
mediaplace_thumb_warmup_done = Fertig – alle Vorschaubilder sind jetzt gecacht.
mediaplace_thumb_warmup_background_failed = {0} von {1} Vorschaubildern konnten im Hintergrund nicht erzeugt werden. Meist erreicht der Server seine eigene Adresse ({2}, Einstellung „server“ im System) nicht – dann bitte „Im Browser starten“ verwenden.
mediaplace_cronjob_ai_alt_complete_title = MediaPlace: ALT-Texte automatisch vervollständigen
mediaplace_cronjob_ai_alt_complete_batch_size = Neue ALT-Texte pro Lauf
mediaplace_cronjob_ai_alt_complete_result = {0} von {1} ALT-Texten erfolgreich vervollständigt ({2} fehlgeschlagen).
mediaplace_cronjob_ai_alt_complete_disabled = Übersprungen: automatische Vervollständigung ist in den Einstellungen nicht aktiviert.
mediaplace_cronjob_ai_alt_complete_unavailable = Übersprungen: KI-Alt-Text-Generierung ist nicht verfügbar.
mediaplace_ai_alt_complete_legend = ALT-Texte vervollständigen
mediaplace_ai_alt_complete_intro = Generiert und speichert per KI automatisch ALT-Texte für ALLE Bilder, denen in mindestens einer Sprache noch ein ALT-Text fehlt – ohne Zwischenschritt zur Prüfung (anders als die Massengenerierung im Medienpool-Overlay, die jeden Vorschlag erst zur Bearbeitung anzeigt).
mediaplace_ai_alt_complete_cronjob_hint = Für einen unbeaufsichtigten, periodisch wiederkehrenden Lauf gibt es zusätzlich den Cronjob-Typ „ALT-Texte automatisch vervollständigen" (Cronjob-Verwaltung), der in konfigurierbaren Kontingenten regelmäßig nachzieht.
mediaplace_ai_alt_complete_start_background = Im Hintergrund starten
mediaplace_ai_alt_complete_start_browser = Im Browser starten
mediaplace_ai_alt_complete_background_hint = „Im Hintergrund" läuft serverseitig weiter, auch wenn der Tab geschlossen wird – die Seite kann jederzeit neu geladen werden und zeigt den laufenden Fortschritt weiter an. „Im Browser" ist der Fallback, falls der Server keine Hintergrundprozesse starten kann (shell_exec deaktiviert).
mediaplace_ai_alt_complete_start = Vervollständigung starten
mediaplace_ai_alt_complete_cancel = Abbrechen
mediaplace_ai_alt_complete_progress = Fortschritt
mediaplace_ai_alt_complete_errors_title = Fehlgeschlagen
mediaplace_ai_alt_complete_done = Fertig – alle erreichbaren ALT-Texte wurden vervollständigt.
mediaplace_ai_alt_complete_disabled_hint = Automatische ALT-Text-Vervollständigung ist deaktiviert. Aktiviere sie in den MediaPlace-Einstellungen ("Automatisch vervollständigen (ohne Vorschau)"), um diese Seite zu nutzen.
mediaplace_ai_alt_complete_ai_unavailable_hint = KI-Alt-Text-Generierung ist nicht aktiviert oder das ai_platform-Addon ist nicht verfügbar.
mediaplace_settings_ai_alt_auto_complete_enable_label = Automatisch vervollständigen (ohne Vorschau)
mediaplace_settings_ai_alt_auto_complete_enable_hint = Schaltet die Admin-Seite „ALT-Texte vervollständigen" sowie den gleichnamigen Cronjob-Typ frei. Generierte Texte werden dort DIREKT gespeichert, ohne vorherige Prüfung durch eine Redaktion – im Unterschied zur Massengenerierung im Medienpool-Overlay, die jeden Vorschlag erst zur Bearbeitung anzeigt. Nur aktivieren, wenn automatisch geschriebene Texte akzeptabel sind.
