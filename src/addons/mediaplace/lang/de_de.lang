mediaplace_cronjob_thumb_warmup_title = MediaPlace: Vorschaubilder vorwärmen
mediaplace_cronjob_thumb_warmup_image_batch_size = Neue Bild-Vorschaubilder pro Lauf
mediaplace_cronjob_thumb_warmup_video_batch_size = Neue Video-Vorschaubilder pro Lauf (nur mit ffmpeg)
