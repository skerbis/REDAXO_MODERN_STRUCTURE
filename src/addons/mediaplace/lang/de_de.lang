mediaplace_settings_alt_field_install_both_btn = ALT-Text- und Dekorativ-Feld anlegen
mediaplace_settings_alt_field_install_decorative_btn = Dekorativ-Feld anlegen
mediaplace_settings_alt_field_install_alt_btn = ALT-Text-Feld anlegen
mediaplace_settings_alt_field_install_success = Feld(er) erfolgreich angelegt.
mediaplace_settings_feature_tagging_label = Tagging (System-Tags) deaktivieren
mediaplace_settings_feature_tagging_hint = Standardmäßig zeigt das Detail-Panel das System-Tags-Feld und die Sidebar den Tag-Filter. Aktivieren blendet beides aus, vorhandene Tags bleiben gespeichert.
mediaplace_settings_feature_collections_label = Sammlungen deaktivieren
mediaplace_settings_feature_collections_hint = Standardmäßig zeigt die Sidebar den Sammlungen-Bereich (anlegen/umbenennen/löschen, Drag&Drop-Zuordnung, Merken-Button auf Kacheln). Aktivieren blendet das aus, vorhandene Sammlungs-Zuordnungen bleiben gespeichert.
