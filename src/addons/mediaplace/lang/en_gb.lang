mediaplace_thumb_warmup_legend = Warm up thumbnails
mediaplace_thumb_warmup_intro = Generates all grid thumbnails once, upfront, instead of only "on demand" when first viewed – useful after a migration or a fresh install with lots of pre-existing files, when many simultaneous thumbnail requests noticeably slow things down while scrolling on a slow server. Runs sequentially in small batches (no parallel rush on the server), files that are already cached are skipped. There's also a cronjob that keeps picking up new files automatically going forward.
mediaplace_thumb_warmup_start_background = Start in background
mediaplace_thumb_warmup_start_browser = Start in browser
mediaplace_thumb_warmup_background_hint = "In background" keeps running on the server even if you close the tab – just reload the page later to see progress. "In browser" drives the process directly from here, the tab needs to stay open; automatic fallback if the server doesn't allow background processes.
mediaplace_thumb_warmup_cancel = Cancel
mediaplace_thumb_warmup_progress = Progress
